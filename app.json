{
  "expo": {
    "name": "naviGO",
    "slug": "navigo-navigation-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "navigo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navigo.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBzw3e-CjEHqn3iq4QfLS6GkQ6jrm7eqL0"
      }
    },
    "android": {
      "package": "com.navigo.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzw3e-CjEHqn3iq4QfLS6GkQ6jrm7eqL0"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "sdkVersion": "53.0.0"
  }
}